<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ML Engineer Portfolio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a192f;
            color: #e6f1ff;
            margin: 0;
            overflow-x: hidden;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            transition: transform 0.3s ease, border-color 0.3s ease;
        }
        .glass-card:hover {
            transform: translateY(-5px);
            border-color: rgba(6, 182, 212, 0.5);
        }
        .cyan-glow {
            box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
        }
        .glow-line {
            height: 2px;
            background: linear-gradient(90deg, transparent, #06b6d4, transparent);
        }
        .text-glow {
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
        }
        .nav-link.active {
            color: #22d3ee;
            border-bottom: 2px solid #22d3ee;
        }
        /* Step 2: Background Animations */
        .blob {
            position: absolute;
            width: 500px;
            height: 500px;
            background: rgba(6, 182, 212, 0.15);
            filter: blur(80px);
            border-radius: 50%;
            z-index: -1;
            animation: move 25s infinite alternate;
        }
        .blob-2 {
            background: rgba(34, 211, 238, 0.1);
            width: 600px;
            height: 600px;
            animation-delay: -5s;
            animation-duration: 30s;
        }
        @keyframes move {
            from { transform: translate(-10%, -10%) rotate(0deg); }
            to { transform: translate(20%, 20%) rotate(360deg); }
        }
        /* Step 5: Modal Styles */
        .modal-overlay {
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
        }
    </style>
</head>
<body class="min-h-screen">
    <!-- Animated Background Blobs -->
    <div class="blob top-[-10%] left-[-10%]"></div>
    <div class="blob blob-2 bottom-[-10%] right-[-10%]"></div>

    <!-- Navbar -->
    <nav id="navbar" class="fixed w-full z-50 px-6 py-4 flex justify-between items-center backdrop-blur-md border-b border-white/5 transition-all duration-300">
        <div class="text-xl font-bold text-cyan-400 tracking-tighter">ML.PORTFOLIO</div>
        <div class="space-x-8 hidden md:flex text-sm font-medium text-slate-300">
