            <h2 class="text-3xl font-bold mb-6">Let's Connect</h2>
            <p class="text-slate-400 mb-8">Currently open to research collaborations and ML engineering roles.</p>
            <a href="mailto:your-email@example.com" class="px-10 py-4 bg-cyan-500 text-slate-900 font-bold rounded-full cyan-glow hover:bg-cyan-400 transition inline-block">
                Get In Touch
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-10 text-center text-slate-500 text-xs border-t border-white/5">
        &copy; 2026 ML Engineer Portfolio. Built with simple HTML & Tailwind.
    </footer>

    <script>
        const navbar = document.getElementById('navbar');
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.nav-link');

        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('py-2', 'bg-[#0a192f]/80');
                navbar.classList.remove('py-4');
            } else {
                navbar.classList.remove('py-2', 'bg-[#0a192f]/80');
                navbar.classList.add('py-4');
            }

            let current = "";
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                if (window.pageYOffset >= (sectionTop - 100)) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href').includes(current)) {
                    link.classList.add('active');
                }
            });
        });

        // Step 5: Modal Logic
        const projectData = {
            proj1: {
                title: "Neural-Net Optimizer",
                desc: "Developed a custom optimizer for transformer models that reduces training time by 15% while maintaining accuracy.",
                details: "This project involved creating a modified AdamW optimizer that dynamically adjusts learning rates based on gradient variance across layers. It was tested on Llama-2 and BERT models, showing significant convergence speedups.",
                tech: ["PyTorch", "Python", "CUDA", "Triton"],
                link: "#"
            },
            proj2: {
                title: "NLP Sentiment Engine",
                desc: "A real-time sentiment analysis pipeline processing 10k requests/sec using BERT and FastAPI.",
                details: "Built a highly scalable inference pipeline. Implemented request batching and model quantization (INT8) using ONNX Runtime to maximize throughput on T4 GPUs.",
                tech: ["HuggingFace", "FastAPI", "Docker", "Kubernetes"],
                link: "#"
            },
            proj3: {
                title: "CV Medical Imaging",
                desc: "Using U-Net architectures to automate tumor segmentation in MRI scans with 94% Dice score.",
                details: "Developed a multi-scale U-Net with attention gates to improve segmentation of small tumor regions. Collaborated with radiologists to validate the ground truth labels.",
                tech: ["TensorFlow", "OpenCV", "Keras", "PyDICOM"],
                link: "#"
            }
        };

        function openModal(id) {
            const project = projectData[id];
            const body = document.getElementById('modal-body');
            body.innerHTML = `
                <h3 class="text-3xl font-bold text-white mb-4">${project.title}</h3>
                <p class="text-cyan-400 font-medium mb-6">${project.desc}</p>
                <div class="text-slate-300 mb-8 leading-relaxed">${project.details}</div>
                <div class="flex flex-wrap gap-2 mb-8">
                    ${project.tech.map(t => `<span class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-xs">${t}</span>`).join('')}
                </div>
                <a href="${project.link}" class="px-6 py-3 bg-cyan-500 text-slate-900 font-bold rounded-lg cyan-glow hover:bg-cyan-400 transition inline-block">
                    Visit Repository
                </a>
            `;
            const modal = document.getElementById('project-modal');
            const content = document.getElementById('modal-content');
            modal.classList.remove('hidden');
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('project-modal');
            const content = document.getElementById('modal-content');
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
    </script>
</body>
</html>
