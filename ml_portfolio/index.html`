    <!-- Projects Section -->
    <section id="projects" class="py-20 px-6 max-w-6xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Featured <span class="text-cyan-400">Projects</span></h2>
