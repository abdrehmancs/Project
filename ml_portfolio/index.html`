            </div>

            <!-- Project 2 -->
            <div class="glass-card p-6 rounded-2xl flex flex-col h-full cursor-pointer group" onclick="openModal('proj2')">
                <div class="h-40 bg-slate-800 rounded-xl mb-6 overflow-hidden relative">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/20 to-transparent"></div>
                    <div class="flex items-center justify-center h-full text-slate-500 font-mono text-xs">Project Visualization</div>
                </div>
                <h3 class="text-xl font-bold mb-3 text-white group-hover:text-cyan-400 transition">NLP Sentiment Engine</h3>
                <p class="text-slate-400 text-sm mb-6 flex-grow">
                    A real-time sentiment analysis pipeline processing 10k requests/sec using BERT and FastAPI.
                </p>
                <div class="flex flex-wrap gap-2 mb-6">
                    <span class="text-[10px] px-2 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded">HuggingFace</span>
                    <span class="text-[10px] px-2 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded">FastAPI</span>
                    <span class="text-[10px] px-2 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded">Docker</span>
                </div>
                <div class="text-cyan-400 text-sm font-semibold flex items-center gap-2">
                    Learn More <span class="group-hover:translate-x-1 transition-transform">→</span>
                </div>
            </div>

            <!-- Project 3 -->
            <div class="glass-card p-6 rounded-2xl flex flex-col h-full cursor-pointer group" onclick="openModal('proj3')">
                <div class="h-40 bg-slate-800 rounded-xl mb-6 overflow-hidden relative">
                    <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/20 to-transparent"></div>
                    <div class="flex items-center justify-center h-full text-slate-500 font-mono text-xs">Project Visualization</div>
                </div>
                <h3 class="text-xl font-bold mb-3 text-white group-hover:text-cyan-400 transition">CV Medical Imaging</h3>
                <p class="text-slate-400 text-sm mb-6 flex-grow">
                    Using U-Net architectures to automate tumor segmentation in MRI scans with 94% Dice score.
                </p>
                <div class="flex flex-wrap gap-2 mb-6">
                    <span class="text-[10px] px-2 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded">TensorFlow</span>
                    <span class="text-[10px] px-2 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded">OpenCV</span>
                    <span class="text-[10px] px-2 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded">Keras</span>
